# --- Base de datos ---
DATABASE_URL=postgresql+psycopg://licitaciones:licitaciones@localhost:5432/licitaciones

# --- Seguridad / JWT ---
SECRET_KEY=cambia-esto-por-un-secreto-largo-y-aleatorio
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- CORS (frontend) ---
FRONTEND_ORIGIN=http://localhost:3000

# --- Almacenamiento de documentos (local por ahora) ---
STORAGE_DIR=storage
MAX_UPLOAD_MB=20

# --- SECOP II ---
# Dataset Socrata "SECOP II - Procesos de Contratación"
SECOP_DATASET_URL=https://www.datos.gov.co/resource/p6dx-8zbt.json
# Token de app de datos.gov.co (opcional, sube el rate limit). Déjalo vacío si no tienes.
SECOP_APP_TOKEN=
SECOP_POLL_SECONDS=3600
SECOP_PAGE_SIZE=500
# Días hacia atrás que considera "reciente" el rastreador.
SECOP_DIAS_RECIENTES=30

# --- Notificaciones por correo (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# STARTTLS: true para Gmail/SendGrid; false para un buzón local de pruebas.
SMTP_USE_TLS=true
SMTP_FROM=Radar de Licitaciones <alertas@tudominio.com>

# --- WhatsApp (Fase 2, opcional) ---
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# --- Telegram (alertas instantáneas, opcional) ---
# Token del bot que da @BotFather. Cada empresa guarda su chat_id desde el panel.
# Vacío = las alertas de Telegram se registran en consola en vez de enviarse.
TELEGRAM_BOT_TOKEN=

# --- IA (vía OpenRouter, opcional) ---
# Una sola key da acceso a muchos modelos. Sin key, las funciones de IA
# (resumen, afinidad, asistente) se desactivan con gracia.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Slug del modelo (ver https://openrouter.ai/models). Calidad: anthropic/claude-haiku-4.5;
# económico: deepseek/deepseek-chat. Usa uno que soporte structured outputs (json_schema).
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
OPENROUTER_APP_NAME=Radar de Licitaciones
